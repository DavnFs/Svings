# Supabase client credentials — copy this file to `.env` and fill in.
# Get these from: https://app.supabase.com/project/_/settings/api
#
# NOTE: `.env` is bundled into the app as a Flutter asset, so anything in it
# ships to every user. Never put SUPABASE_SERVICE_ROLE_KEY here — it bypasses
# Row Level Security and must stay server-side only.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# Google OAuth, for the Gmail email-sync feature.
#
# This is the WEB application client ID, not the Android one. google_sign_in 7
# uses it as `serverClientId`. You still need an Android client too — that one
# identifies the app by package name + signing SHA-1 and never appears in code.
# Both live in the same Google Cloud project, with the Gmail API enabled.
GOOGLE_SERVER_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
